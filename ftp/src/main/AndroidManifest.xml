<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Pause/Cancel on the sync notification. Not exported: only the app's own
        PendingIntent can start it.
    -->
    <application>
        <receiver
            android:name=".worker.FtpNotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
