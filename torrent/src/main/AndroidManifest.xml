<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        TorrentDownloadWorker reads ConnectivityManager.isActiveNetworkMetered to
        honour the "Wi-Fi only" constraint. Declared here so lint is satisfied in
        the library module; the app module declares it for the merged manifest.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>