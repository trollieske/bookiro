<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base theme shared by every API level. The app is always dark (HUD-black),
        so system-bar icons must be light and the window background must be black
        to avoid a white flash before Compose draws.
    -->
    <style name="Theme.Shelf.Base" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- windowLightNavigationBar requires API 27; safely ignored on API 26. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.Shelf" parent="Theme.Shelf.Base" />

    <color name="paper_warm">#FFFBF7F0</color>
</resources>